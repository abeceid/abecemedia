---
interface Item { when: string; title: string; text?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ol class="timeline">
  {items.map((it) => (
    <li>
      <span class="when">{it.when}</span>
      <div>
        <h3>{it.title}</h3>
        {it.text && <p>{it.text}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .timeline { list-style: none; margin: 40px 0 0; padding: 0; border-left: 2px solid var(--line); }
  li { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 0 0 24px 20px; position: relative; }
  li::before { content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--teal); }
  .when { font-weight: 600; font-size: 14px; color: var(--teal); }
  h3 { font: 700 17px/1.3 var(--sans); margin: 0 0 4px; }
  @media (max-width: 760px) { li { grid-template-columns: 1fr; gap: 2px; } }
</style>
