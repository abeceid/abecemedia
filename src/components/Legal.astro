---
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
  title: string;
  updated: string;
}
const { title, updated } = Astro.props;
---
<Base title={`${title} · abece`}>
  <Header />
  <main class="wrap legal">
    <p class="eyebrow">Diperbarui {updated}</p>
    <h1>{title}</h1>
    <slot />
  </main>
  <Footer />
</Base>

<style>
  .legal { padding-top: 32px; padding-bottom: 96px; max-width: 760px; }
  .eyebrow {
    margin: 0 0 12px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--teal);
  }
  h1 { font: 800 clamp(34px, 5vw, 52px)/1.1 var(--sans); letter-spacing: -0.03em; margin: 0 0 32px; }
  .legal :global(h2) { font-size: 24px; margin: 40px 0 12px; max-width: none; }
  .legal :global(h3) { font: 700 18px/1.3 var(--sans); margin: 28px 0 8px; }
  .legal :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 56px 0 8px; }
  .legal :global(li) { margin-bottom: 6px; }
</style>
