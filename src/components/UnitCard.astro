---
interface Link { label: string; url: string }
interface Props {
  name: string;
  tagline: string;
  since: number;
  description: string;
  logo: string;
  color: string;
  url: string;
  cta: string;
  links: Link[];
}
const { name, tagline, since, description, logo, color, url, cta, links } = Astro.props;
---
<article class="unit">
  <div class="unit-mark" style={`background:${color}`}><img src={logo} alt={name} /></div>
  <div class="unit-body">
    <h3>{name}</h3>
    <p class="tag">{tagline} · sejak {since}</p>
    <p class="desc">{description}</p>
    <div class="links">
      <a class="btn" href={url}>{cta}</a>
      {links.map((l) => <a href={l.url} rel="noopener">{l.label}</a>)}
    </div>
  </div>
</article>

<style>
  .unit { display: grid; grid-template-columns: 240px 1fr; background: var(--paper); border: 1px solid var(--line); border-radius: 20px; overflow: hidden; margin-top: 8px; }
  .unit + .unit { margin-top: 20px; }
  .unit-mark { display: grid; place-items: center; padding: 32px; }
  .unit-mark img { width: 100%; max-width: 180px; display: block; }
  .unit-body { padding: 32px 36px; }
  h3 { font: 800 28px/1.1 var(--sans); letter-spacing: -0.02em; margin: 0 0 6px; }
  .tag { font-size: 15px; color: var(--muted); margin: 0 0 16px; }
  .desc { color: var(--ink) !important; margin: 0 0 20px; }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 22px; font-size: 15px; }
  .links a { text-decoration: none; color: var(--teal); font-weight: 600; }
  .links a:hover { text-decoration: underline; }
  .btn { display: inline-block; background: var(--ink); color: var(--cream) !important; padding: 12px 22px; border-radius: 999px; font-weight: 700 !important; }
  .btn:hover { background: var(--teal); text-decoration: none !important; }
  @media (max-width: 760px) {
    .unit { grid-template-columns: 1fr; }
    .unit-body { padding: 24px 20px; }
    .links .btn { flex-basis: 100%; text-align: center; }
  }
</style>
